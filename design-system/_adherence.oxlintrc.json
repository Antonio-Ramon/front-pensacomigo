{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blog/**",
              "components/core/**",
              "ui_kits/admin-editor/**",
              "ui_kits/public-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Source Serif 4|Instrument Sans))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Source Serif 4, Instrument Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:draft|published|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'draft' | 'published' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|warm|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'warm' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:pad|hover|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: pad, hover."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommentData'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|avatar|time|children|key|ref|className|style|children)$/]",
        "message": "<CommentData> doesn't accept that prop. Declared props: name, avatar, time, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|message|confirmLabel|cancelLabel|tone|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: open, title, message, confirmLabel, cancelLabel, tone, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:danger|accent)$/]",
        "message": "<ConfirmDialog> tone must be one of 'danger' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|message|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, message, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|wrapStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, wrapStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkPreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|title|description|image|domain|key|ref|className|style|children)$/]",
        "message": "<LinkPreview> doesn't accept that prop. Declared props: url, title, description, image, domain."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|avatar|date|readTime|size|key|ref|className|style|children)$/]",
        "message": "<MetaLine> doesn't accept that prop. Declared props: author, avatar, date, readTime, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLine'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<MetaLine> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|excerpt|image|author|date|readTime|tags|layout|key|ref|className|style|children)$/]",
        "message": "<PostCard> doesn't accept that prop. Declared props: title, excerpt, image, author, date, readTime, tags, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:card|row)$/]",
        "message": "<PostCard> layout must be one of 'card' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:overline|title|align|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: overline, title, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|width|height|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: shape, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:line|title|thumb|circle)$/]",
        "message": "<Skeleton> shape must be one of 'line' | 'title' | 'thumb' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|tone|size|onRemove|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: active, tone, size, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warm|teal)$/]",
        "message": "<Tag> tone must be one of 'warm' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Tag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagFilter'] > JSXAttribute > JSXIdentifier[name!=/^(?:tags|active|onChange|allLabel|key|ref|className|style|children)$/]",
        "message": "<TagFilter> doesn't accept that prop. Declared props: tags, active, onChange, allLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|wrapStyle|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, wrapStyle."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Avatar": { "replaces": [] },
      "Badge": { "replaces": [] },
      "Button": { "replaces": [] },
      "Card": { "replaces": [] },
      "CommentData": { "replaces": [] },
      "ConfirmDialog": { "replaces": [] },
      "EmptyState": { "replaces": [] },
      "IconButton": { "replaces": [] },
      "Input": { "replaces": [] },
      "LinkPreview": { "replaces": [] },
      "MetaLine": { "replaces": [] },
      "PostCard": { "replaces": [] },
      "SectionHeading": { "replaces": [] },
      "SelectOption": { "replaces": [] },
      "Skeleton": { "replaces": [] },
      "Tag": { "replaces": [] },
      "TagFilter": { "replaces": [] },
      "Textarea": { "replaces": [] }
    },

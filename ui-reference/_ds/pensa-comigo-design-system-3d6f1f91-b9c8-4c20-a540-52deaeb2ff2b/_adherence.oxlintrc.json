{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Inter Tight|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Inter Tight, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApplyList'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|items|key|ref|className|style|children)$/]",
        "message": "<ApplyList> doesn't accept that prop. Declared props: label, title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|bio|key|ref|className|style|children)$/]",
        "message": "<AuthorBox> doesn't accept that prop. Declared props: name, initials, bio."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, initials, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|published|draft|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'published' | 'draft' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|ghost|quiet|accent)$/]",
        "message": "<Button> variant must be one of 'solid' | 'ghost' | 'quiet' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:solid|dashed)$/]",
        "message": "<Card> tone must be one of 'solid' | 'dashed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:pressed|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: pressed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Comment'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|date|depth|replies|key|ref|className|style|children)$/]",
        "message": "<Comment> doesn't accept that prop. Declared props: author, date, depth, replies."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|message|confirmLabel|cancelLabel|tone|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: open, title, message, confirmLabel, cancelLabel, tone, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|danger)$/]",
        "message": "<ConfirmDialog> tone must be one of 'default' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: label, title, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|shape|wrapStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, shape, wrapStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|box)$/]",
        "message": "<Input> shape must be one of 'pill' | 'box'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|readTime|items|key|ref|className|style|children)$/]",
        "message": "<MetaLine> doesn't accept that prop. Declared props: date, readTime, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoodChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<MoodChips> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|cta|placeholder|tone|onSubscribe|key|ref|className|style|children)$/]",
        "message": "<NewsletterCTA> doesn't accept that prop. Declared props: title, description, cta, placeholder, tone, onSubscribe."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterCTA'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dashed|solid)$/]",
        "message": "<NewsletterCTA> tone must be one of 'dashed' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pager'] > JSXAttribute > JSXIdentifier[name!=/^(?:prev|next|key|ref|className|style|children)$/]",
        "message": "<Pager> doesn't accept that prop. Declared props: prev, next."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|label|height|key|ref|className|style|children)$/]",
        "message": "<PostImage> doesn't accept that prop. Declared props: src, alt, caption, label, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|title|dek|tags|image|imageAlt|key|ref|className|style|children)$/]",
        "message": "<PostRow> doesn't accept that prop. Declared props: date, title, dek, tags, image, imageAlt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute > JSXIdentifier[name!=/^(?:html|fontSize|key|ref|className|style|children)$/]",
        "message": "<Prose> doesn't accept that prop. Declared props: html, fontSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reactions'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|key|ref|className|style|children)$/]",
        "message": "<Reactions> doesn't accept that prop. Declared props: options."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|hint|as|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, hint, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeading> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|wrapStyle|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, wrapStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|description|refs|cta|key|ref|className|style|children)$/]",
        "message": "<StageCard> doesn't accept that prop. Declared props: number, title, description, refs, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<StudyNote> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|primary)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'accent' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|wrapStyle|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, wrapStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:themes|storageKey|key|ref|className|style|children)$/]",
        "message": "<ThemeSwitcher> doesn't accept that prop. Declared props: themes, storageKey."
      },
      {
        "selector": "JSXOpeningElement[name.name='TocRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sections|activeId|onSelect|tools|key|ref|className|style|children)$/]",
        "message": "<TocRail> doesn't accept that prop. Declared props: label, sections, activeId, onSelect, tools."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerseBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:reference|key|ref|className|style|children)$/]",
        "message": "<VerseBlock> doesn't accept that prop. Declared props: reference."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerseTerminal'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|command|cite|key|ref|className|style|children)$/]",
        "message": "<VerseTerminal> doesn't accept that prop. Declared props: slug, command, cite."
      }
    ]
  },

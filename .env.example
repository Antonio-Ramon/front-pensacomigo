# URL base da API (usada no servidor; dev = backend local)
API_URL=http://localhost:5001

# Base pública do Supabase Storage para montar URL de imagem a partir do path gravado.
# Formato: https://<projeto>.supabase.co/storage/v1/object/public/<bucket>
NEXT_PUBLIC_STORAGE_URL=

# URL pública do site (SEO/OG); dev pode deixar vazio
NEXT_PUBLIC_SITE_URL=
